@model ProjetLibrairie.Models.Emprunt

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Attestation d'emprunt - @Model.Livre?.Titre</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            color: #1a202c;
            background-color: #f1f5f9;
            margin: 0;
            padding: 50px 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .receipt-container {
            max-width: 520px;
            width: 100%;
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            border: 1px solid #e2e8f0;
            padding: 40px;
            box-sizing: border-box;
            position: relative;
        }

            /* Effet décoratif de ticket de bibliothèque */
            .receipt-container::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 8px;
                background: linear-gradient(90deg, #3182ce 0%, #4299e1 100%);
                border-radius: 24px 24px 0 0;
            }

        .header {
            text-align: center;
            margin-bottom: 35px;
            padding-bottom: 25px;
            border-bottom: 2px dashed #cbd5e1;
        }

            .header .icon-box {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 56px;
                height: 56px;
                background-color: #ebf8ff;
                color: #2b6cb0;
                border-radius: 16px;
                font-size: 1.6rem;
                margin-bottom: 15px;
            }

            .header h1 {
                font-size: 1.1rem;
                text-transform: uppercase;
                letter-spacing: 2px;
                color: #64748b;
                margin: 0 0 6px 0;
                font-weight: 600;
            }

            .header h2 {
                font-size: 1.7rem;
                color: #1e3a8a;
                margin: 0;
                font-weight: 800;
            }

        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }

            .info-table tr {
                border-bottom: 1px solid #f1f5f9;
            }

                .info-table tr:last-child {
                    border-bottom: none;
                }

            .info-table td {
                padding: 16px 0;
                font-size: 0.95rem;
                vertical-align: middle;
            }

                .info-table td.label {
                    font-weight: 600;
                    color: #64748b;
                    width: 45%;
                }

                    .info-table td.label i {
                        margin-right: 8px;
                        color: #94a3b8;
                        font-size: 1.1rem;
                    }

                .info-table td.value {
                    color: #0f172a;
                    font-weight: 600;
                    text-align: right;
                }

        /* Badge Date de retour stylisé */
        .badge-date {
            background-color: #fef2f2;
            color: #dc2626;
            padding: 6px 14px;
            border-radius: 8px;
            font-weight: 700;
            border: 1px solid #fecaca;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        /* Bloc d'instructions moderne */
        .instructions-box {
            background-color: #f0fdf4; /* Teinte verte pour indiquer que tout est OK */
            border: 1px solid #bbf7d0;
            padding: 18px;
            border-radius: 14px;
            margin-top: 25px;
            display: flex;
            gap: 12px;
        }

            .instructions-box i {
                color: #16a34a;
                font-size: 1.3rem;
                margin-top: 2px;
            }

            .instructions-box p {
                margin: 0;
                font-size: 0.88rem;
                color: #14532d;
                line-height: 1.5;
            }

        /* Section Code-barres simulé (très important pour l'effet ticket) */
        .barcode-section {
            text-align: center;
            margin: 30px 0 15px 0;
            padding-top: 20px;
            border-top: 1px dashed #e2e8f0;
        }

        .fake-barcode {
            letter-spacing: 4px;
            font-size: 2.2rem;
            color: #0f172a;
            font-family: 'Courier New', Courier, monospace;
            font-weight: bold;
            opacity: 0.85;
            line-height: 1;
            margin-bottom: 4px;
        }

        .barcode-sub {
            font-size: 0.75rem;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .footer {
            margin-top: 30px;
            text-align: center;
            font-size: 0.8rem;
            color: #94a3b8;
            border-top: 1px solid #f1f5f9;
            padding-top: 25px;
            line-height: 1.4;
        }

        /* Gestion de la mise en page lors du clic sur Imprimer */
        @@media print {
            body {
                background-color: #ffffff;
                padding: 0;
            }

            .receipt-container {
                box-shadow: none;
                border: none;
                padding: 10px;
            }

                .receipt-container::before {
                    display: none;
                }
        }
    </style>
</head>
<body>

    <div class="receipt-container">

        <div class="header">
            <div class="icon-box">
                <i class="bi bi-book-half"></i>
            </div>
            <h1>Bibliothèque Universitaire</h1>
            <h2>Ticket d'Emprunt</h2>
        </div>

        <table class="info-table">
            <tr>
                <td class="label"><i class="bi bi-person-vcard"></i> Adhérent</td>
                <td class="value">@Model.Adherent?.Nom @Model.Adherent?.Prenom</td>
            </tr>
            <tr>
                <td class="label"><i class="bi bi-bookmark-star"></i> Livre</td>
                <td class="value" style="color: #2b6cb0;">@Model.Livre?.Titre</td>
            </tr>
            <tr>
                <td class="label"><i class="bi bi-pencil-square"></i> Auteur</td>
                <td class="value">@Model.Livre?.Auteur</td>
            </tr>
            <tr>
                <td class="label"><i class="bi bi-calendar-check"></i> Date d'emprunt</td>
                <td class="value">@Model.DateEmprunt.ToString("dd/MM/yyyy")</td>
            </tr>
            <tr>
                <td class="label"><i class="bi bi-calendar-x"></i> À retourner avant le</td>
                <td class="value">
                    <span class="badge-date">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        @Model.DateEmprunt.AddDays(14).ToString("dd/MM/yyyy")
                    </span>
                </td>
            </tr>
        </table>

        <div class="barcode-section">
            <div class="fake-barcode">||| | |||| || | ||| ||</div>
            <div class="barcode-sub">EMP-@Model.DateEmprunt.ToString("yyyyMMdd")-@Model.Id</div>
        </div>

        <div class="instructions-box">
            <i class="bi bi-info-circle-fill"></i>
            <p>
                <strong>Instruction de retrait :</strong><br />
                Présentez ce code au guichet de la bibliothèque (version imprimée ou sur l'écran de votre smartphone) pour finaliser la récupération physique de l'ouvrage.
            </p>
        </div>

        <div class="footer">
            Généré automatiquement le @DateTime.Now.ToString("dd/MM/yyyy à HH:mm")<br />
            Merci de votre confiance et bonne lecture !
        </div>

    </div>

</body>
</html>
@model ProjetLibrairie.Models.Emprunt

@{
    ViewData["Title"] = "Détails emprunt";

    var dateLimite = Model.DateEmprunt.AddDays(14);
    bool rendu = Model.DateRetour.HasValue;
    bool enRetard = !rendu && DateTime.Now.Date > dateLimite.Date;
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-slate-900 mb-1">Détails de la transaction</h2>
        <div class="text-muted">Référence système : <span class="badge bg-light text-dark border">#@Model.Id</span></div>
    </div>

    <div>
        @if (rendu)
        {
            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-10 px-3 py-1.5 rounded-pill fw-semibold fs-6">
                <i class="bi bi-check2-circle me-1"></i> Ouvrage Rendu
            </span>
        }
        else if (enRetard)
        {
            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-10 px-3 py-1.5 rounded-pill fw-semibold fs-6">
                <i class="bi bi-exclamation-triangle me-1"></i> Alerte Retard
            </span>
        }
        else
        {
            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-10 px-3 py-1.5 rounded-pill fw-semibold fs-6">
                <i class="bi bi-hourglass-split me-1"></i> Emprunt en cours
            </span>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header border-0 bg-transparent pt-4 px-4 pb-2">
                <h5 class="fw-bold text-slate-900 mb-0"><i class="bi bi-calendar3 me-1.5 text-primary"></i> Suivi des dates</h5>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="vstack gap-3">
                    <div class="p-3 bg-light rounded-3 d-flex justify-content-between align-items-center">
                        <span class="text-muted small fw-semibold">Date de sortie :</span>
                        <span class="font-monospace fw-bold text-slate-900">@Model.DateEmprunt.ToString("dd MMMM yyyy")</span>
                    </div>
                    <div class="p-3 bg-light rounded-3 d-flex justify-content-between align-items-center border-start border-warning border-4">
                        <span class="text-muted small fw-semibold">Date limite fixée :</span>
                        <span class="font-monospace fw-bold text-slate-900">@dateLimite.ToString("dd MMMM yyyy")</span>
                    </div>
                    <div class="p-3 bg-light rounded-3 d-flex justify-content-between align-items-center @(rendu ? "border-start border-success border-4" : "")">
                        <span class="text-muted small fw-semibold">Restitution physique :</span>
                        <span class="font-monospace fw-bold @(rendu ? "text-success" : "text-muted")">
                            @(rendu? Model.DateRetour?.ToString("dd MMMM yyyy") : "Non restitué")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header border-0 bg-transparent pt-4 px-4 pb-2">
                <h5 class="fw-bold text-slate-900 mb-0"><i class="bi bi-person-lines-fill me-1.5 text-primary"></i> Objets de liaison</h5>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="mb-3.5 pb-3 border-bottom">
                    <span class="text-muted small d-block mb-1 text-uppercase fw-bold tracking-wider" style="font-size: 0.7rem;">Ouvrage lié</span>
                    <h6 class="fw-bold text-slate-900 mb-0">@(Model.Livre?.Titre ?? "(Livre introuvable)")</h6>
                    <span class="text-muted small">par @(Model.Livre?.Auteur ?? "-")</span>
                </div>
                <div>
                    <span class="text-muted small d-block mb-1 text-uppercase fw-bold tracking-wider" style="font-size: 0.7rem;">Adhérent / Emprunteur</span>
                    @if (Model.Adherent != null)
                    {
                        <h6 class="fw-bold text-slate-900 mb-0">@Model.Adherent.Nom @Model.Adherent.Prenom</h6>
                        <a href="mailto:@Model.Adherent.Email" class="small text-decoration-none text-primary"><i class="bi bi-envelope me-1"></i>@Model.Adherent.Email</a>
                    }
                    else
                    {
                        <span class="text-muted small">Profil anonymisé ou supprimé.</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-4 d-flex gap-2">
    <a class="btn btn-outline-secondary d-inline-flex align-items-center px-4" asp-action="Index">
        <i class="bi bi-arrow-left me-2"></i> Retour à la liste
    </a>
</div>
@model IEnumerable<ProjetLibrairie.Models.Livre>
@using ProjetLibrairie.Helpers

@{
    ViewData["Title"] = "Livres disponibles";
    bool isAdh = AuthSession.EstAdherent(Context);
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-slate-900 mb-1">Livres disponibles</h2>
        <div class="text-muted">Parcourez les ouvrages actuellement présents dans nos rayonnages.</div>
    </div>
    <a class="btn btn-outline-primary d-inline-flex align-items-center shadow-sm" asp-controller="Accueil" asp-action="Recherche">
        <i class="bi bi-search me-2"></i> Recherche filtrée
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 45%;">Titre de l'œuvre</th>
                        <th style="width: 25%;">Auteur</th>
                        <th style="width: 15%;">Catégorie</th>
                        <th class="text-end pe-4" style="width: 15%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-muted py-5 text-center">
                                <div class="mb-2"><i class="bi bi-book fs-1 opacity-40"></i></div>
                                Tous nos ouvrages sont actuellement réservés ou en cours de lecture.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var l in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2.5">
                                        <div class="bg-success bg-opacity-10 text-success rounded-2 p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                            <i class="bi bi-journal-check small"></i>
                                        </div>
                                        <span class="fw-bold text-slate-900 fs-6">@l.Titre</span>
                                    </div>
                                </td>
                                <td class="text-slate-700">@l.Auteur</td>
                                <td>
                                    <span class="badge bg-light text-dark border">@(l.Categorie?.Nom ?? "-")</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">
                                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Livres" asp-action="Details" asp-route-id="@l.Id">
                                            Voir
                                        </a>
                                        @if (isAdh)
                                        {
                                            <a class="btn btn-sm btn-primary d-inline-flex align-items-center" asp-controller="Emprunts" asp-action="Creer" asp-route-livreId="@l.Id">
                                                <i class="bi bi-plus-circle me-1"></i> Emprunter
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
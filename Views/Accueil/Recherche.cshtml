@model List<ProjetLibrairie.Models.Livre>
@{
    ViewData["Title"] = "Recherche";
    string q = (ViewBag.Q as string) ?? "";
}

<div class="mb-4">
    <h2 class="fw-bold text-slate-900 mb-1">Moteur de recherche</h2>
    <div class="text-muted">Explorez instantanément tout le catalogue par titre, auteur ou thématique.</div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-10">
                <div class="input-group input-group-lg position-relative">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search fs-5"></i></span>
                    <input id="qInput"
                           class="form-control form-control-lg border-start-0 ps-1"
                           name="q"
                           value="@q"
                           placeholder="Saisissez votre recherche ici (ex: Hugo, Roman, Algorithmique)..."
                           autocomplete="off" />
                </div>
            </div>
            <div class="col-12 col-md-2 d-grid">
                <button id="clearBtn" class="btn btn-outline-secondary btn-lg" type="button">
                    <i class="bi bi-x-circle me-2"></i> Effacer
                </button>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 mt-3 text-muted small bg-light p-2.5 rounded-3">
            <div id="loading" class="spinner-border spinner-border-sm text-primary d-none" role="status"></div>
            <i id="infoIcon" class="bi bi-info-circle text-primary"></i>
            <span id="hint">Les résultats s'actualisent automatiquement à la saisie.</span>
        </div>
    </div>

    <div class="border-top bg-transparent">
        <div id="results">
            <partial name="_ResultatsRechercheLivres" model="Model" />
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const qInput = document.getElementById('qInput');
        const results = document.getElementById('results');
        const loading = document.getElementById('loading');
        const infoIcon = document.getElementById('infoIcon');
        const clearBtn = document.getElementById('clearBtn');

        let timer = null;
        let abortController = null;

        function debounceSearch() {
            clearTimeout(timer);
            timer = setTimeout(runSearch, 300);
        }

        async function runSearch() {
            const q = qInput.value || "";

            // annule la requête précédente si l'utilisateur tape vite
            if (abortController) abortController.abort();
            abortController = new AbortController();

            loading.classList.remove('d-none');
            infoIcon.classList.add('d-none');

            try {
                const url = `@Url.Action("RecherchePartial", "Accueil")?q=${encodeURIComponent(q)}`;
                const resp = await fetch(url, { signal: abortController.signal });

                if (!resp.ok) throw new Error("HTTP " + resp.status);

                const html = await resp.text();
                results.innerHTML = html;
            } catch (e) {
                // si abort -> normal
                if (e.name !== "AbortError") {
                    results.innerHTML = `<div class="text-danger p-4 text-center fw-medium"><i class="bi bi-exclamation-triangle-fill me-2"></i>Une erreur est survenue lors du chargement des données.</div>`;
                }
            } finally {
                loading.classList.add('d-none');
                infoIcon.classList.remove('d-none');
            }
        }

        qInput.addEventListener('input', debounceSearch);

        clearBtn.addEventListener('click', () => {
            qInput.value = "";
            qInput.focus();
            runSearch();
        });
    </script>
}
@model IEnumerable<ProjetLibrairie.Models.Livre>
@using ProjetLibrairie.Helpers

@{
    bool isAdh = AuthSession.EstAdherent(Context);
}

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th style="width: 35%;">Titre de l'ouvrage</th>
                <th style="width: 25%;">Auteur</th>
                <th style="width: 15%;">Catégorie</th>
                <th class="text-center" style="width: 10%;">Statut</th>
                <th class="text-end" style="width: 15%;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-muted py-5 text-center">
                        <div class="mb-2"><i class="bi bi-folder-x fs-1 opacity-50"></i></div>
                        Aucun livre ne correspond exactement à votre recherche.
                    </td>
                </tr>
            }
            else
            {
                foreach (var l in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-slate-900">@l.Titre</div>
                        </td>
                        <td class="text-slate-600">@l.Auteur</td>
                        <td>
                            <span class="badge bg-light text-secondary border px-2 py-1.5 fw-medium">
                                @(l.Categorie?.Nom ?? "Non classé")
                            </span>
                        </td>
                        <td class="text-center">
                            @if (l.Disponible)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-20 px-2.5 py-1.5 rounded-pill small fw-semibold">
                                    <i class="bi bi-check2 me-1"></i> Disponible
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-20 px-2.5 py-1.5 rounded-pill small fw-semibold">
                                    <i class="bi bi-clock me-1"></i> Emprunté
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center text-nowrap"
                                   asp-controller="Livres"
                                   asp-action="Details"
                                   asp-route-id="@l.Id"
                                   title="Consulter la fiche détaillée">
                                    <i class="bi bi-eye me-1"></i> Détails
                                </a>

                                @if (isAdh && l.Disponible)
                                {
                                    <a class="btn btn-sm btn-primary d-inline-flex align-items-center text-nowrap shadow-sm"
                                       asp-controller="Emprunts"
                                       asp-action="Creer"
                                       asp-route-livreId="@l.Id">
                                        <i class="bi bi-plus-circle me-1"></i> Emprunter
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
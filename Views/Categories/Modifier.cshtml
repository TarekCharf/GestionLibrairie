@model ProjetLibrairie.Models.Categorie

@{
    ViewData["Title"] = "Modifier une catégorie";
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-slate-900 mb-1">Modifier la catégorie</h2>
        <div class="text-muted">Ajustez l'intitulé officiel de la classification.</div>
    </div>
    <a class="btn btn-outline-secondary d-inline-flex align-items-center" asp-action="Index">
        <i class="bi bi-arrow-left me-2"></i> Annuler et retourner
    </a>
</div>

<div class="row">
    <div class="col-12 col-md-8 col-lg-6 mx-auto">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-sm-5">

                <form asp-action="Modifier" method="post" class="row g-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="col-12">
                            <div class="alert alert-danger border-0 shadow-sm d-flex align-items-start gap-2 mb-0" role="alert">
                                <i class="bi bi-exclamation-triangle-fill fs-5 mt-0.5"></i>
                                <div>
                                    <h6 class="fw-bold mb-1">Veuillez corriger l'erreur :</h6>
                                    <div asp-validation-summary="All" class="small text-danger"></div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="col-12">
                        <div class="bg-light p-2.5 rounded border mb-1 small text-muted font-monospace">
                            Identifiant technique immuable : <strong>#@Model.Id</strong>
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Nom" class="form-label fw-semibold text-slate-700">Libellé mis à jour</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-pencil"></i></span>
                            <input asp-for="Nom" class="form-control form-control-lg" />
                        </div>
                        <span asp-validation-for="Nom" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 border-top pt-4 mt-4 d-flex gap-2 justify-content-end">
                        <a class="btn btn-outline-secondary px-4" asp-action="Index">Abandonner</a>
                        <button class="btn btn-primary px-4 d-inline-flex align-items-center shadow-sm" type="submit">
                            <i class="bi bi-save me-1.5"></i> Appliquer les modifications
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
@using Microsoft.AspNetCore.Http
@using ProjetLibrairie.Helpers
@inject IHttpContextAccessor HttpAccessor

@{
    var ctx = HttpAccessor.HttpContext!;
    var role = ctx.Session.GetString("Role") ?? "";
    bool isAdmin = ctx.Session.GetInt32("AdminId") != null;
    bool isAdh = ctx.Session.GetInt32("AdherentId") != null;

    string titre = ViewData["Title"] as string ?? "Bibliothèque";
    string currentController = (ViewContext.RouteData.Values["controller"]?.ToString()) ?? "";
    string currentAction = (ViewContext.RouteData.Values["action"]?.ToString()) ?? "";

    string IsActive(string controller, string? action = null)
    {
        if (!string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase))
            return "";
        if (action == null) return "active";
        return string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@titre - Bibliothèque universitaire</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" asp-controller="Accueil" asp-action="Index">
                <i class="bi bi-book-half text-primary-light me-2 fs-4"></i>
                <span>Biblio Univ</span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                    <li class="nav-item">
                        <a class="nav-link @IsActive("Accueil", "Index")" asp-controller="Accueil" asp-action="Index">
                            <i class="bi bi-grid-1x2-fill me-2"></i>Accueil
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @IsActive("Accueil", "Recherche")" asp-controller="Accueil" asp-action="Recherche">
                            <i class="bi bi-search me-2"></i>Recherche
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @IsActive("Emprunts", "LivresDisponibles")" asp-controller="Emprunts" asp-action="LivresDisponibles">
                            <i class="bi bi-bookmark-check-fill me-2"></i>Disponibles
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @IsActive("Emprunts", "LivresEmpruntes")" asp-controller="Emprunts" asp-action="LivresEmpruntes">
                            <i class="bi bi-bookmark-x-fill me-2"></i>Empruntés
                        </a>
                    </li>

                    @if (isAdh)
                    {
                        <li class="nav-item">
                            <a class="nav-link @IsActive("Emprunts", "MesEmprunts")" asp-controller="Emprunts" asp-action="MesEmprunts">
                                <i class="bi bi-journal-bookmark-fill me-2"></i>Mes emprunts
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @IsActive("Adherents", "Details")" asp-controller="Adherents" asp-action="Details">
                                <i class="bi bi-person-bounding-box me-2"></i>Mon profil
                            </a>
                        </li>
                    }

                    @if (isAdmin)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-sliders me-2"></i>Administration
                            </a>
                            <ul class="dropdown-menu shadow">
                                <li><a class="dropdown-item" asp-controller="Livres" asp-action="Index"><i class="bi bi-book me-2"></i>Gestion livres</a></li>
                                <li><a class="dropdown-item" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags me-2"></i>Gestion catégories</a></li>
                                <li><a class="dropdown-item" asp-controller="Adherents" asp-action="Index"><i class="bi bi-people me-2"></i>Gestion adhérents</a></li>
                                <li><a class="dropdown-item" asp-controller="Emprunts" asp-action="Index"><i class="bi bi-arrow-left-right me-2"></i>Gestion emprunts</a></li>
                                <li><a class="dropdown-item" asp-controller="Commentaires" asp-action="Index"><i class="bi bi-chat-left-text me-2"></i>Gestion commentaires</a></li>
                                <li><a class="dropdown-item" asp-controller="Ratings" asp-action="Index"><i class="bi bi-star-fill me-2"></i>Gestion ratings</a></li>
                            </ul>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    @if (AuthSession.EstAdmin(Context))
                    {
                        <li class="nav-item text-light">
                            <div class="user-badge text-white d-flex align-items-center gap-2">
                                <i class="bi bi-shield-lock-fill text-warning"></i>
                                <span>Admin : <strong>@AuthSession.AdminLogin(Context)</strong></span>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm px-3" asp-controller="Compte" asp-action="Deconnexion">Déconnexion</a>
                        </li>
                    }
                    else if (AuthSession.EstAdherent(Context))
                    {
                        <li class="nav-item text-light">
                            <div class="user-badge text-white d-flex align-items-center gap-2">
                                <i class="bi bi-person-circle text-info"></i>
                                <span><strong>@AuthSession.AdherentPrenom(Context) @AuthSession.AdherentNom(Context)</strong></span>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm px-3" asp-controller="Compte" asp-action="Deconnexion">Déconnexion</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Compte" asp-action="Connexion">Connexion</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm px-3 text-white" asp-controller="Compte" asp-action="Inscription">Inscription</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container app-content">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="py-4 mt-auto">
        <div class="container text-muted small d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>© @DateTime.Now.Year - <strong>Bibliothèque Universitaire</strong></div>
            <div class="text-end text-muted opacity-75">Propulsé par ProjetLibrairie</div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
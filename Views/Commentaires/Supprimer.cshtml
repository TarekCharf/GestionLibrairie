@model ProjetLibrairie.Models.Commentaire

@{
    ViewData["Title"] = "Supprimer le commentaire";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-6 col-lg-5">
        <div class="card border-0 shadow-lg mt-5">
            <div class="card-body p-4 text-center">
                <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 64px; height: 64px;">
                    <i class="bi bi-exclamation-triangle fs-2"></i>
                </div>

                <h4 class="fw-bold text-slate-900 mb-2">Supprimer ce commentaire ?</h4>
                <p class="text-muted mb-4">Cette action est définitive. Le commentaire de <strong>@Model.Adherent?.Prenom</strong> sur le livre <em>@Model.Livre?.Titre</em> sera retiré.</p>

                <div class="bg-light p-3 rounded-3 mb-4 text-start small">
                    "@Model.Texte"
                </div>

                <form asp-action="Supprimer">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger btn-lg">Confirmer la suppression</button>
                        <a asp-action="Index" class="btn btn-link text-muted text-decoration-none">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
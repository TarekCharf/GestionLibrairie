@model ProjetLibrairie.Models.Rating

@{
    ViewData["Title"] = "Modifier la note";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <h3 class="fw-bold text-slate-900 mb-3">Mettre à jour votre note</h3>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <form asp-action="Modifier">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="LivreId" />
                    <input type="hidden" asp-for="AdherentId" />
                    <input type="hidden" asp-for="DateNotation" />

                    <div class="mb-4">
                        <label asp-for="Valeur" class="form-label fw-bold">Nouvelle note</label>
                        <select asp-for="Valeur" class="form-select form-select-lg">
                            <option value="5">⭐⭐⭐⭐⭐ — Excellent</option>
                            <option value="4">⭐⭐⭐⭐ — Très bon</option>
                            <option value="3">⭐⭐⭐ — Moyen</option>
                            <option value="2">⭐⭐ — Médiocre</option>
                            <option value="1">⭐ — Mauvais</option>
                        </select>
                        <span asp-validation-for="Valeur" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a href="javascript:history.back()" class="btn btn-light px-4">Annuler</a>
                        <button type="submit" class="btn btn-warning px-4 fw-semibold text-white shadow-sm">
                            Enregistrer les changements
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
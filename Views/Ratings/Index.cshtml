@model IEnumerable<ProjetLibrairie.Models.Rating>

@{
    ViewData["Title"] = "Gestion des évaluations";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold text-slate-900 mb-1">Notes & Évaluations</h2>
        <div class="text-muted small">Modération et aperçu global des avis de la bibliothèque.</div>
    </div>
    <span class="badge bg-dark px-3 py-2 rounded-pill fw-bold">@Model.Count() au total</span>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-uppercase tracking-wider" style="font-size: 0.75rem;">
                <tr>
                    <th class="ps-4 py-3">Lecteur</th>
                    <th class="py-3">Livre évalué</th>
                    <th class="py-3 text-center">Note</th>
                    <th class="py-3">Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold text-slate-900">@item.Adherent?.Nom @item.Adherent?.Prenom</div>
                            <div class="small text-muted" style="font-size: 0.8rem;">@item.Adherent?.Email</div>
                        </td>
                        <td>
                            <div class="fw-semibold text-truncate" style="max-width: 220px;">@item.Livre?.Titre</div>
                            <div class="small text-muted" style="font-size: 0.8rem;">par @item.Livre?.Auteur</div>
                        </td>
                        <td class="text-center">
                            @{
                                var badgeColor = item.Valeur >= 4 ? "bg-success" : (item.Valeur == 3 ? "bg-warning text-dark" : "bg-danger");
                            }
                            <span class="badge @badgeColor px-2.5 py-1.5 rounded-3 fw-bold">
                                @item.Valeur / 5 ⭐
                            </span>
                        </td>
                        <td class="small text-muted">@item.DateNotation.ToString("d")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
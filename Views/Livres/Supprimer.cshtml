@model ProjetLibrairie.Models.Livre

@{
    ViewData["Title"] = "Supprimer un livre";
}

<div class="d-flex align-items-end justify-content-between flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-0">Supprimer un livre</h2>
        <div class="text-muted">Livre #@Model.Id</div>
    </div>

    <a class="btn btn-outline-secondary" asp-action="Index">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="alert alert-warning">
            Voulez-vous vraiment supprimer ce livre ? Cette action est irréversible.
        </div>

        <dl class="row mb-3">
            <dt class="col-sm-3 text-muted">Titre</dt>
            <dd class="col-sm-9 fw-semibold">@Model.Titre</dd>

            <dt class="col-sm-3 text-muted">Auteur</dt>
            <dd class="col-sm-9">@Model.Auteur</dd>

            <dt class="col-sm-3 text-muted">Catégorie</dt>
            <dd class="col-sm-9">@((Model.Categorie?.Nom) ?? "-")</dd>

            <dt class="col-sm-3 text-muted">Disponibilité</dt>
            <dd class="col-sm-9">
                @if (Model.Disponible)
                {
                    <span class="badge text-bg-success">Disponible</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">Emprunté</span>
                }
            </dd>
        </dl>

        <form asp-action="Supprimer" method="post" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Supprimer
            </button>
            <a class="btn btn-outline-secondary" asp-action="Index">Annuler</a>
        </form>
    </div>
</div>
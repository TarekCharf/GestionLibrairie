@model IEnumerable<ProjetLibrairie.Models.Livre>
@using ProjetLibrairie.Helpers

@{
    ViewData["Title"] = "Liste des livres";
    bool isAdh = AuthSession.EstAdherent(Context);
    bool isAdmin = AuthSession.EstAdmin(Context);
}

<div class="d-flex align-items-end justify-content-between flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-0">Livres</h2>
        <div class="text-muted">Catalogue de la bibliothèque</div>
    </div>

    @if (isAdmin)
    {
        <a class="btn btn-primary" asp-action="Creer">
            <i class="bi bi-plus-lg"></i> Ajouter un livre
        </a>
    }
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Titre</th>
                        <th>Auteur</th>
                        <th>Catégorie</th>
                        <th class="text-center">Rating</th>
                        <th class="text-center">Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Aucun livre.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var l in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@l.Titre</td>
                                <td>@l.Auteur</td>
                                <td>@(l.Categorie?.Nom ?? "-")</td>

                                <td class="text-center">
                                    @if (l.Ratings != null && l.Ratings.Any())
                                    {
                                        var moyenne = l.Ratings.Average(r => r.Valeur);
                                        <span class="text-warning"><i class="bi bi-star-fill me-1"></i></span>
                                        <span class="fw-bold">@moyenne.ToString("0.0")</span>
                                        <span class="text-muted small">/5 (@l.Ratings.Count)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Aucune note</span>
                                    }
                                </td>

                                <td class="text-center">
                                    @if (l.Disponible)
                                    {
                                        <span class="badge text-bg-success">Disponible</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Emprunté</span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-action="Details"
                                       asp-route-id="@l.Id">
                                        Détails
                                    </a>

                                    @if (isAdh && l.Disponible)
                                    {
                                        <a class="btn btn-sm btn-primary ms-1"
                                           asp-controller="Emprunts"
                                           asp-action="Creer"
                                           asp-route-livreId="@l.Id">
                                            Emprunter
                                        </a>
                                    }

                                    @if (isAdmin)
                                    {
                                        <a class="btn btn-sm btn-outline-warning ms-1"
                                           asp-action="Modifier"
                                           asp-route-id="@l.Id">
                                            Modifier
                                        </a>
                                        <a class="btn btn-sm btn-outline-danger ms-1"
                                           asp-action="Supprimer"
                                           asp-route-id="@l.Id">
                                            Supprimer
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>